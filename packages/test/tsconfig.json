{
  "compileOnSave": false,
  "compilerOptions": {
    "declaration": true,
    "esModuleInterop": true,
    "module": "commonjs",
    "outDir": "./build",
    "resolveJsonModule": true,
    "strict": true,
    "target": "ES2020"
  },
  "exclude": [
    "**/build",
    "**/test",
    "./node_modules/**/*"
  ],
  "include": [
    "**/*.ts",
  ]
}
